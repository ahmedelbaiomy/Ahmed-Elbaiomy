{{ 'ee-header.css' | asset_url | stylesheet_tag }}

<div class="ee-banner__header">
  <span class="ee-banner__menu-icon" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </span>

  <div class="ee-banner__logo">
    {% if section.settings.logo != blank %}
      {{
        section.settings.logo
        | image_url: width: 200
        | image_tag: loading: 'eager'
      }}
    {% else %}
      <span class="ee-banner__logo-text">{{ section.settings.brand_text }}</span>
    {% endif %}
  </div>

  <p class="ee-banner__header-text">
    {{ section.settings.header_text }}
  </p>

  <a
    class="ee-banner__header-cta"
    href="{{ section.settings.top_button_link }}"
  >
    <span>{{ section.settings.top_button_text }}</span>
    <span class="ee-banner__header-cta-icon" aria-hidden="true">
      {% if section.settings.top_button_icon != blank %}
        {{ section.settings.top_button_icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
      {% else %}
        →
      {% endif %}
    </span>
  </a>
</div>
