{{ 'ee-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ee-product-grid.js' | asset_url }}" defer></script>

<section class="ee-grid" id="ee-grid-{{ section.id }}">
  <h2 class="ee-grid__heading">{{ section.settings.heading }}</h2>

  <div class="ee-grid__list">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="ee-grid__item" {{ block.shopify_attributes }}>
        {% if product %}
          {% assign image_alt = product.featured_image.alt | default: product.title %}
          <button
            type="button"
            class="ee-grid__card"
            data-ee-grid-trigger
            data-block-id="{{ block.id }}"
          >
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag:
                class: 'ee-grid__image',
                loading: 'lazy',
                widths: '400, 600, 800',
                alt: image_alt
            }}
            <span class="ee-grid__hotspot" aria-hidden="true">+</span>
          </button>
          <script type="application/json" id="ee-grid-product-{{ block.id }}">
            {{ product | json }}
          </script>
        {% else %}
          <div class="ee-grid__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'ee-grid__placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "EE Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "EE Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
