{{ 'ee-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ee-product-grid.js' | asset_url }}" defer></script>

<section
  class="ee-grid"
  id="ee-grid-{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <h2 class="ee-grid__heading">{{ section.settings.heading }}</h2>

  <div class="ee-grid__list">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      <div class="ee-grid__item" {{ block.shopify_attributes }}>
        {% if product.id %}
          {% assign image_alt = product.featured_image.alt | default: product.title %}
          <button
            type="button"
            class="ee-grid__card"
            data-ee-grid-trigger
            data-block-id="{{ block.id }}"
          >
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag:
                class: 'ee-grid__image',
                loading: 'lazy',
                widths: '400, 600, 800',
                alt: image_alt
            }}
            <span
              class="ee-grid__hotspot"
              aria-hidden="true"
              style="--hotspot-x: {{ block.settings.hotspot_x }}%; --hotspot-y: {{ block.settings.hotspot_y }}%;"
            >
              <img src="{{ 'circle-plus.svg' | asset_url }}" alt="" width="26" height="26">
            </span>
          </button>
          <script type="application/json" id="ee-grid-product-{{ block.id }}">
            {{ product | json | replace: '</', '<\/' }}
          </script>
        {% else %}
          <div class="ee-grid__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'ee-grid__placeholder-svg' }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ee-grid__modal" hidden>
    <div class="ee-grid__modal-overlay" data-ee-grid-close></div>
    <div class="ee-grid__modal-dialog" role="dialog" aria-modal="true" tabindex="-1">
      <button type="button" class="ee-grid__modal-close" data-ee-grid-close aria-label="Close">
        <img src="{{ 'cross.svg' | asset_url }}" alt="" width="15" height="15">
      </button>

      <div class="ee-grid__modal-head">
        <div class="ee-grid__modal-media">
          <img class="ee-grid__modal-image" src="" alt="">
        </div>

        <div class="ee-grid__modal-info">
          <h3 class="ee-grid__modal-title"></h3>
          <p class="ee-grid__modal-price"></p>
        </div>
      </div>

      <div class="ee-grid__modal-description"></div>

      <div class="ee-grid__modal-options"></div>

      <button type="button" class="ee-grid__modal-add" disabled>
        <span>Add to cart</span>
        <span aria-hidden="true">
          <img src="{{ 'arrow-white.svg' | asset_url }}" alt="" width="26" height="12">
        </span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EE Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "EE Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
