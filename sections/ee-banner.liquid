{{ 'ee-banner.css' | asset_url | stylesheet_tag }}

<section class="ee-banner" id="ee-banner-{{ section.id }}">
  <div class="ee-banner__header">
    <div class="ee-banner__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 200
          | image_tag: loading: 'eager'
        }}
      {% else %}
        <span class="ee-banner__logo-text">{{ section.settings.brand_text }}</span>
      {% endif %}
    </div>

    <p class="ee-banner__header-text">
      {{ section.settings.header_text }}
    </p>

    <a
      class="ee-banner__header-cta"
      href="{{ section.settings.top_button_link }}"
    >
      <span>{{ section.settings.top_button_text }}</span>
      <span class="ee-banner__header-cta-icon" aria-hidden="true">
        {% if section.settings.top_button_icon != blank %}
          {{ section.settings.top_button_icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
        {% else %}
          →
        {% endif %}
      </span>
    </a>
  </div>

  <div class="ee-banner__hero">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'ee-banner__image',
          loading: 'eager',
          widths: '750, 1100, 1500, 2000'
      }}
    {% endif %}

    <div class="ee-banner__content">
      <h1 class="ee-banner__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="ee-banner__description">
        {{ section.settings.description }}
      </div>

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="ee-banner__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ee-banner__ticker">
    {{ section.settings.ticker_text }}
  </div>
</section>

{% schema %}
{
  "name": "EE Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Logo fallback text",
      "info": "Shown only if no logo image is uploaded",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header center text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Header button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Header button link"
    },
    {
      "type": "image_picker",
      "id": "top_button_icon",
      "label": "Header button icon",
      "info": "Optional. Falls back to an arrow if not set"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "EE Banner"
    }
  ]
}
{% endschema %}