{{ 'ee-banner.css' | asset_url | stylesheet_tag }}

<section class="ee-banner" id="ee-banner-{{ section.id }}">
  <div class="ee-banner__topbar">
    <p class="ee-banner__brand">
      {{ section.settings.brand_text }}
    </p>

    <a
      class="ee-banner__gift-link"
      href="{{ section.settings.top_button_link }}"
    >
      {{ section.settings.top_button_text }}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="ee-banner__hero">
    {% if section.settings.background_image != blank %}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'ee-banner__image',
          loading: 'eager',
          widths: '750, 1100, 1500, 2000'
      }}
    {% endif %}

    <div class="ee-banner__content">
      <h1 class="ee-banner__heading">
        {{ section.settings.heading }}
      </h1>

      <div class="ee-banner__description">
        {{ section.settings.description }}
      </div>

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="ee-banner__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ee-banner__ticker">
    {{ section.settings.ticker_text }}
  </div>
</section>

{% schema %}
{
  "name": "EE Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ticker_text",
      "label": "Bottom text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "EE Banner"
    }
  ]
}
{% endschema %}